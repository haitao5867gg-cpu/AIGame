# 复制为 .env 后填写；.env 不会提交到版本库。
LLM_BASE=https://aigw.telecomjs.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_MODEL_WORLD=deepseek-v4.1-flash
LLM_MOCK=0
LLM_TIMEOUT_MS=90000
LLM_DAILY_TOKEN_LIMIT=2000000
# 每位玩家（含主人）各自的每日 token 上限，0 表示不限；与上面的全局上限相互独立。
LLM_PLAYER_DAILY_TOKEN_LIMIT=1000000
# 可选：额外的 LLM 请求体参数（JSON 字符串，合并进每次请求）。
# 某些网关支持关闭思考链以提速，例如：
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
# 公网来客访问密码：经 Cloudflare 隧道进来的朋友需先输入；主人（本机 / Tailscale）免密。
# 留空表示首次启动自动生成 6 位数字，生成结果与 HMAC 密钥一起存在 data/access.json，之后复用。
ACCESS_PASSWORD=
# ---- 朋友访问：自动启动 Cloudflare 临时隧道 ----
# 启动一个临时 trycloudflare.com 链接，朋友用上面的访问密码登录后即可访问本机服务。
# 没有访问密码（或处于 LLM_MOCK 模式）时绝不启动；TUNNEL=off 表示不启动。
TUNNEL=on
# cloudflared 可执行文件路径；留空则自动在 PATH 和 Windows 常见安装位置查找。
CLOUDFLARED_PATH=
# 出图：逗号分隔的回退链，前一家失败就换下一家。
# siliconflow=硅基流动 Kolors（免费） modelscope=魔搭 Z-Image-Turbo（免费额度，需绑定阿里云，单张约 1~2 分钟）
# cloudflare=Cloudflare Workers AI flux-1-schnell（每日免费 Neurons 额度，约 2 秒一张，提示词自动译成英文）
# zhipu=智谱 cogview-3-flash（免费） gateway=公司网关（付费） local=本地 SDXL off=不出图
IMAGE_PROVIDER=siliconflow,zhipu,cloudflare,modelscope,local
SILICONFLOW_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MODELSCOPE_API_KEY=
ZHIPU_API_KEY=
