# 复制为 .env 后填写；.env 不会提交到版本库。
LLM_BASE=https://aigw.telecomjs.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_MODEL_WORLD=deepseek-v4.1-flash
LLM_MOCK=0
# 叙事写法：v1=旧写法（默认，2~4 短段落、每段 ≤90 字）；v2=小说化写法（篇幅随场景、重写作手法）。
# 默认 v1，线上不受影响；仅做对比实验时改为 v2。
NARRATIVE_STYLE=v1
LLM_TIMEOUT_MS=90000
LLM_DAILY_TOKEN_LIMIT=2000000
# 每位玩家（含主人）各自的每日 token 上限，0 表示不限；与上面的全局上限相互独立。
LLM_PLAYER_DAILY_TOKEN_LIMIT=1000000
# 可选：额外的 LLM 请求体参数（JSON 字符串，合并进每次请求）。
# 某些网关支持关闭思考链以提速，例如：
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
# 公网来客访问密码：经 Cloudflare 隧道进来的朋友需先输入；主人（本机 / Tailscale）免密。
# 留空表示首次启动自动生成 6 位数字，生成结果与 HMAC 密钥一起存在 data/access.json，之后复用。
ACCESS_PASSWORD=
# 主人口令：主人在手机等设备上通过朋友链接「主人登录」时使用，不要发给朋友。
# 留空则首次启动自动生成 16 位（字母数字，去掉易混字符 0O1lI），与 HMAC 密钥一起存 data/access.json，之后复用。
HOST_PASSWORD=
# ---- 朋友访问：自动启动 Cloudflare 临时隧道 ----
# 启动一个临时 trycloudflare.com 链接，朋友用上面的访问密码登录后即可访问本机服务。
# 没有访问密码（或处于 LLM_MOCK 模式）时绝不启动；TUNNEL=off 表示不启动。
TUNNEL=on
# cloudflared 可执行文件路径；留空则自动在 PATH 和 Windows 常见安装位置查找。
CLOUDFLARED_PATH=
# 出图：逗号分隔的回退链，前一家失败就换下一家。
# siliconflow=硅基流动 Kolors（免费） modelscope=魔搭 Z-Image-Turbo（免费额度，需绑定阿里云，单张约 1~2 分钟）
# cloudflare=Cloudflare Workers AI flux-1-schnell（每日免费 Neurons 额度，约 2 秒一张，提示词自动译成英文）
# zhipu=智谱 cogview-3-flash（免费） gateway=公司网关（付费） local=本地 SDXL off=不出图
IMAGE_PROVIDER=siliconflow,zhipu,cloudflare,modelscope,local
SILICONFLOW_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Cloudflare Workers AI 每日免费 Neurons 额度，UTC 零点重置（默认 10000）。
# 今日已用达到 CLOUDFLARE_RESERVE_FROM（默认 7000）后，物品 / 头像 / 主角形象图改用回退链下一家，
# 把剩余额度留给场景图；收到「daily free allocation」的 429 则冷却到下一个 UTC 零点。
CLOUDFLARE_DAILY_NEURONS=10000
CLOUDFLARE_RESERVE_FROM=7000
# 场景插图用 FLUX.2 klein-4b 多参考图（主角形象 / NPC 头像 / 物品图，最多 4 张）合成 16:9 场景。
# 留空字符串表示停用参考图、直接走上面的文生图回退链；失败（额度用完 / HTTP 错误）也会自动落回文生图。
IMAGE_SCENE_REF_MODEL=@cf/black-forest-labs/flux-2-klein-4b
MODELSCOPE_API_KEY=
ZHIPU_API_KEY=
# 每位来客每天最多生成多少张场景插图（回合结果里的 scene 图）；0 表示不限，主人不受此限。
IMAGE_SCENE_DAILY_PER_PLAYER=60
# ---- 朗读：Azure 语音服务（叙事合成语音）----
# 两项都填好才会启用朗读；缺任意一项时 /api/tts 返回 503「朗读服务未配置」。
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# 每位来客每日朗读字符上限；0 表示不限，主人不受限。
TTS_PLAYER_DAILY_CHARS=10000
# 朗读音频缓存（DATA_DIR/tts/）总大小上限（MB）；超出后按文件修改时间删最旧，降到 80%。
TTS_CACHE_MAX_MB=300
# Azure F0 免费档每月 50 万字符：按 UTC 月统计 kind=tts 且非缓存的字数。
TTS_MONTHLY_CHARS=500000
# 本月已用达到此值即停用 Azure 朗读（前端改用浏览器朗读），留缓冲避免超额；下月自动恢复。
TTS_MONTHLY_STOP_AT=450000
